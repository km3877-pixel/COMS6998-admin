# Use the SAME verified Supabase project as the consumer app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Server only: uploads/unpublished image previews and caption generation.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Optional direct providers; configure only on the server.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
